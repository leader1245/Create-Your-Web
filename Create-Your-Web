<style>
:root{
  --bg:#FFFFFF; --text:#0F1B2D; --soft:#44546A; --mist:#F2F5F9; --surface:#FFFFFF;
  --line:#DCE3EC; --field:#8A97A8; --deep:#0F1B2D; --deep-text:#FFFFFF; --deep-soft:#D5DDE8;
  --wa:#0B7A3E; --wa-dark:#085F30; --zap:#FFC233; --accent-link:#0B7A3E;
  --radius:14px; color-scheme:light;
  --display:"Bricolage Grotesque","Segoe UI",system-ui,sans-serif;
  --body:"Figtree",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
}
:root[data-theme="dark"]{
  --bg:#0B1220; --text:#E8EEF6; --soft:#A9B6C8; --mist:#101A2C; --surface:#152038;
  --line:#26344D; --field:#6F809A; --deep:#16233B; --deep-text:#FFFFFF; --deep-soft:#C3CEDD;
  --accent-link:#4ADE80; color-scheme:dark;
}
:root:lang(ar){--display:"Cairo","Segoe UI",Tahoma,sans-serif;--body:"Cairo","Segoe UI",Tahoma,sans-serif}
*{box-sizing:border-box}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
body{margin:0;font-family:var(--body);font-size:1.0625rem;line-height:1.6;color:var(--text);background:var(--bg);transition:background .25s,color .25s}
:lang(ar) body{line-height:1.8}
img,svg{max-width:100%;display:block}
h1,h2,h3{font-family:var(--display);line-height:1.15;margin:0;letter-spacing:-.02em}
:lang(ar) h1,:lang(ar) h2,:lang(ar) h3{letter-spacing:0;line-height:1.35}
h1{font-size:clamp(2.3rem,7.5vw,4.3rem);font-weight:800}
h2{font-size:clamp(1.8rem,4.5vw,2.6rem);font-weight:800}
h3{font-size:1.3rem;font-weight:600;letter-spacing:-.01em}
p{margin:0}
a{color:inherit}
:focus-visible{outline:3px solid var(--zap);outline-offset:3px;border-radius:6px}
.wrap{width:min(1120px,100% - 2.5rem);margin-inline:auto}
section{padding:clamp(3.5rem,9vw,6rem) 0}
.lead{font-size:1.2rem;color:var(--soft);max-width:34rem}
.skip{position:absolute;inset-inline-start:-999px;top:0;background:var(--zap);color:#0F1B2D;padding:.6rem 1rem;z-index:100}
.skip:focus{inset-inline-start:0}

/* Buttons */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:.6rem;min-height:52px;padding:.8rem 1.5rem;border-radius:999px;font:600 1.05rem var(--body);text-decoration:none;border:0;cursor:pointer;transition:background .2s,transform .15s}
.btn svg{width:22px;height:22px;flex:none}
.btn-wa{background:var(--wa);color:#fff}
.btn-wa:hover{background:var(--wa-dark)}
.btn:active{transform:scale(.98)}
.btn-sm{min-height:44px;padding:.5rem 1.1rem;font-size:.98rem}
.chip{min-height:44px;min-width:44px;padding:.4rem .9rem;border-radius:999px;border:1.5px solid var(--line);background:var(--surface);color:var(--text);font:600 .95rem var(--body);cursor:pointer;display:inline-flex;align-items:center;justify-content:center}
.chip:hover{border-color:var(--text)}
.chip svg{width:20px;height:20px}
.ic-sun{display:none}
:root[data-theme="dark"] .ic-sun{display:block}
:root[data-theme="dark"] .ic-moon{display:none}

/* Header */
header{position:sticky;top:0;z-index:50;background:color-mix(in srgb,var(--bg) 92%,transparent);backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}
.bar{display:flex;align-items:center;justify-content:space-between;gap:.75rem;min-height:64px}
.tools{display:flex;align-items:center;gap:.5rem}
.logo{font:800 1.25rem var(--display);text-decoration:none;letter-spacing:-.02em;margin-inline-end:auto}
:lang(ar) .logo{letter-spacing:0}

/* Hero */
.hero{padding-top:clamp(2.5rem,7vw,5rem);background:linear-gradient(180deg,var(--mist),var(--bg))}
.hero-grid{display:grid;gap:2.5rem;align-items:center}
.hero h1 span{background:linear-gradient(transparent 62%,var(--zap) 62% 92%,transparent 92%);color:var(--text)}
:root[data-theme="dark"] .hero h1 span{background:linear-gradient(transparent 62%,rgba(255,194,51,.45) 62% 92%,transparent 92%)}
.hero .lead{margin:1.25rem 0 1.75rem}
.hero-note{margin-top:1rem;font-size:.95rem;color:var(--soft)}
.mock{background:var(--deep);border-radius:var(--radius);padding:.9rem;box-shadow:0 24px 50px -24px rgba(0,0,0,.55)}
.mock-top{display:flex;gap:.4rem;padding:.2rem .3rem .8rem}
.mock-top i{width:11px;height:11px;border-radius:50%;background:#3B4B63}
.mock-body{background:var(--surface);border-radius:8px;padding:1.2rem;display:grid;gap:.7rem}
.m{background:var(--line);border-radius:6px;height:12px}
.m.hd{height:26px;width:70%;background:var(--text)}
.m.s{width:85%}.m.xs{width:55%}
.m.cta{height:34px;width:42%;background:var(--wa);border-radius:999px;margin-top:.4rem}
.mock-row{display:grid;grid-template-columns:repeat(3,1fr);gap:.6rem;margin-top:.5rem}
.mock-row b{height:64px;border-radius:8px;background:var(--mist);border:1px solid var(--line)}

/* Selling points */
.two{display:grid;gap:1.25rem;margin-top:2.25rem}
.big{border-radius:var(--radius);padding:2rem 1.75rem}
.big p{margin-top:.8rem;max-width:30rem}
.big.fast{background:var(--deep);color:#fff;border:1px solid transparent}
:root[data-theme="dark"] .big.fast{border-color:var(--line)}
.big.fast p{color:var(--deep-soft)}
.big.cheap{background:var(--zap);color:#0F1B2D}
.big svg{width:44px;height:44px;margin-bottom:1rem}


.alt{background:var(--mist)}

/* Services */
.cards{display:grid;gap:1rem;margin-top:2.25rem;grid-template-columns:1fr}
.card{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);padding:1.4rem}
.card p{color:var(--soft);margin-top:.4rem}

/* Steps (a real sequence, so numbered) */
.steps{list-style:none;padding:0;margin:2.25rem 0 0;display:grid;gap:1.25rem;counter-reset:s}
.steps li{counter-increment:s;display:grid;grid-template-columns:3rem 1fr;gap:1rem;align-items:start}
.steps li::before{content:counter(s);display:grid;place-items:center;width:3rem;height:3rem;border-radius:50%;background:var(--deep);color:var(--zap);font:800 1.3rem var(--display)}
.steps p{color:var(--soft)}

/* Quote form */
.quote{background:var(--deep);color:var(--deep-text)}
.quote-grid{display:grid;gap:2.5rem}
.quote .lead{color:var(--deep-soft);margin-top:1rem}
form{background:var(--surface);color:var(--text);border-radius:var(--radius);padding:1.5rem;display:grid;gap:1rem}
label{font-weight:600;display:grid;gap:.35rem;font-size:1rem}
input,select,textarea{font:inherit;font-size:1rem;color:var(--text);padding:.75rem .9rem;border:1.5px solid var(--field);border-radius:10px;background:var(--bg);width:100%;min-height:48px}
textarea{min-height:96px;resize:vertical}
.hint{font-size:.9rem;color:var(--soft);text-align:center}

/* FAQ */
details{border-bottom:1px solid var(--line);padding:1rem 0}
summary{cursor:pointer;font:600 1.1rem var(--display);list-style:none;display:flex;justify-content:space-between;gap:1rem;min-height:44px;align-items:center}
summary::-webkit-details-marker{display:none}
summary::after{content:"+";font-size:1.6rem;line-height:1;color:var(--accent-link)}
details[open] summary::after{content:"\2212"}
details p{color:var(--soft);margin-top:.5rem;max-width:42rem}
.faq{max-width:760px}

/* Final CTA + footer */
.final{text-align:center}
.final .lead{margin:1rem auto 1.75rem}
footer{background:var(--deep);color:var(--deep-soft);padding:2rem 0 6rem;font-size:.95rem}
footer .wrap{display:flex;flex-wrap:wrap;justify-content:space-between;gap:.75rem}
footer a{color:#fff}

/* Floating WhatsApp button (mobile) */
.float{position:fixed;inset-inline-end:1rem;bottom:1rem;z-index:60;box-shadow:0 10px 24px -8px rgba(0,0,0,.5)}
.hide-sm{display:none}

@media (min-width:560px){.hide-sm{display:inline-flex}}
@media (min-width:760px){
  .hero-grid{grid-template-columns:1.15fr .85fr}
  .two{grid-template-columns:1fr 1fr}
  .cards{grid-template-columns:repeat(2,1fr)}
  .quote-grid{grid-template-columns:1fr 1fr;align-items:center}
  footer{padding-bottom:2rem}
  .float{display:none}
}
@media (min-width:1000px){.cards{grid-template-columns:repeat(4,1fr)}}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{transition:none!important}}
</style>
</head>

