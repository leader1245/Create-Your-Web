/* ---------- Logic (no need to edit below) ---------- */
var root = document.documentElement;
function lang(){ return root.lang === "ar" ? "ar" : "en"; }
function waLink(text){ return "https://wa.me/" + NUMBER + "?text=" + encodeURIComponent(text); }
function save(k,v){ try{ localStorage.setItem(k,v); }catch(e){} }

function applyLang(){
  var l = lang(), d = T[l];
  root.dir = l === "ar" ? "rtl" : "ltr";
  document.title = d.title;
  document.querySelector('meta[name="description"]').content = d.desc;
  document.querySelectorAll("[data-i18n]").forEach(function(el){ el.textContent = d[el.dataset.i18n]; });
  document.querySelectorAll("[data-i18n-html]").forEach(function(el){ el.innerHTML = d[el.dataset.i18nHtml]; });
  document.querySelectorAll("[data-i18n-aria]").forEach(function(el){ el.setAttribute("aria-label", d[el.dataset.i18nAria]); });
  document.querySelectorAll("[data-wa]").forEach(function(a){ a.href = waLink(d.greet); });
  var lb = document.getElementById("lang-btn");     // button shows the OTHER language
  lb.textContent = l === "ar" ? "English" : "العربية";
  lb.lang = l === "ar" ? "en" : "ar";
  applyTheme();
}
function applyTheme(){
  var dark = root.getAttribute("data-theme") === "dark";
  var b = document.getElementById("theme-btn");
  b.setAttribute("aria-label", dark ? T[lang()].theme_to_light : T[lang()].theme_to_dark);
  b.setAttribute("aria-pressed", dark);
  document.querySelector('meta[name="theme-color"]') && 0;
}

document.getElementById("lang-btn").addEventListener("click", function(){
  root.lang = lang() === "ar" ? "en" : "ar"; save("lang", root.lang); applyLang();
});
document.getElementById("theme-btn").addEventListener("click", function(){
  var next = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
  root.setAttribute("data-theme", next); save("theme", next); applyTheme();
});

// Quote form: build a pre-filled WhatsApp message in the current language
document.getElementById("quote-form").addEventListener("submit", function(e){
  e.preventDefault();
  var f = e.target, d = T[lang()], det = f.details.value.trim();
  var msg = d.msg_a + f.name.value.trim() + d.msg_b + f.type.value + "." +
            (det ? "\n\n" + d.msg_c + det : "") + "\n\n" + d.msg_d;
  window.open(waLink(msg), "_blank", "noopener");
});

document.getElementById("yr").textContent = new Date().getFullYear();
applyLang();
